{
  "opencollection": "1.0.0",
  "info": {
    "name": "METACRAN CranDB Badges API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Badges",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Download Count Badge",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://crandb.r-pkg.org/badges/:period/:package",
            "params": [
              {
                "name": "period",
                "value": "",
                "type": "path",
                "description": "Badge period (last-day, last-week, grand-total)"
              },
              {
                "name": "package",
                "value": "",
                "type": "path",
                "description": "R package name"
              }
            ]
          },
          "docs": "Returns an SVG badge showing the download count for an R package over the specified period. Suitable for embedding in README files."
        }
      ]
    }
  ],
  "bundled": true
}